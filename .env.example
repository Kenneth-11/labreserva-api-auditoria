# Copiar a .env y completar. NUNCA subir .env a git.
PORT=3000
NODE_ENV=development
# Generar con: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Orígenes (separados por coma) que pueden llamar a la API desde un navegador. Vacío = solo mismo origen.
CORS_ORIGINS=
